{
  "name": "@anglerai/react-native-analytics",
  "version": "0.1.0-rc.2",
  "description": "Angler app analytics and attribution for React Native (iOS and Android).",
  "license": "MIT",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "ios",
    "android",
    "AnglerAnalyticsRN.podspec",
    "!**/__tests__",
    "!android/build",
    "!android/.gradle"
  ],
  "scripts": {
    "test": "jest && node --test scripts/__tests__/",
    "prepack": "node scripts/sync-native.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react-native": ">=0.76"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "typescript": "~5.6.3"
  },
  "codegenConfig": {
    "name": "AnglerAnalyticsSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "ai.getangler.analytics.reactnative"
    }
  }
}
